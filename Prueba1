<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prueba de Reproducción HLS</title>
  <!-- Cargamos la librería para reproducir m3u8 en cualquier navegador -->
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <style>
    body { font-family: sans-serif; text-align: center; background: #121212; color: white; padding: 20px; }
    video { width: 100%; max-width: 500px; border-radius: 8px; background: #000; }
    input, button { padding: 10px; margin-top: 10px; border-radius: 5px; border: none; }
    button { background: #007bff; color: white; cursor: pointer; }
  </style>
</head>
<body>

  <h2>Prueba de Extractor m3u8</h2>
  
  <video id="video" controls playsinline></video>
  <br>
  <input type="text" id="videoId" placeholder="ID de YouTube" value="36cgoyKzdg0">
  <button onclick="cargarVideo()">Reproducir Video</button>

  <script>
    async function cargarVideo() {
      const id = document.getElementById('videoId').value.trim();
      const video = document.getElementById('video');

      if (!id) return alert("Ingresa un ID válido");

      try {
        // Consultamos la API pública de extracción
        const res = await fetch(`https://pipedapi.kavin.rocks/streams/${id}`);
        const data = await res.json();
        
        const hlsUrl = data.hls;

        if (!hlsUrl) return alert("No se encontró transmisión HLS.");

        // Si Hls.js es soportado (Android/Chrome/PC)
        if (Hls.isSupported()) {
          const hls = new Hls();
          hls.loadSource(hlsUrl);
          hls.attachMedia(video);
          hls.on(Hls.Events.MANIFEST_PARSED, () => video.play());
        } 
        // Para Safari en iPhone (Soporte HLS Nativo)
        else if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = hlsUrl;
          video.addEventListener('loadedmetadata', () => video.play());
        }

      } catch (err) {
        console.error(err);
        alert("Error al obtener la información del video.");
      }
    }
  </script>
</body>
</html>
